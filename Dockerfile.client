FROM node:22-alpine AS build

WORKDIR /app

COPY client/package*.json ./
RUN npm ci

COPY client/ ./
RUN npm run build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4999

COPY client/package*.json ./
RUN npm ci --omit=dev

COPY client/server.js ./server.js
COPY --from=build /app/dist ./dist

EXPOSE 4999
CMD ["npm", "start"]
